# Public site and patient portal
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=replace-with-a-cryptographically-random-secret
PATIENT_AUTH_URL=https://your-auth-service.example/patient/login

# Patient data protection (production: use a random 32-byte base64 value)
PATIENT_DATA_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Vercel KV (appointments, availability, feedback, portal records)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob private file storage for pre-authorisation documents
BLOB_READ_WRITE_TOKEN=

# Google reCAPTCHA v3 + visible v2 fallback
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
RECAPTCHA_V3_SCORE_THRESHOLD=0.5

# SMTP / Nodemailer
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Gilead Medical Centre <no-reply@your-domain.example>
CONTACT_EMAIL=contact@your-domain.example
BOOKING_COORDINATOR_EMAIL=bookings@your-domain.example
PREAUTH_NOTIFICATION_EMAIL=preauth@your-domain.example

# WhatsApp Business Cloud API (optional until configured)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example/api/portal/pay/callback
MPESA_CALLBACK_SECRET=replace-with-a-long-random-secret

# Video-call provider integration (configure before enabling telemedicine confirmations)
TELEMEDICINE_BASE_URL=
TELEMEDICINE_LINK_SECRET=
